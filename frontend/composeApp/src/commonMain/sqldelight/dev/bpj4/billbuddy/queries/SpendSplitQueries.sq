insertSpendSplits:
INSERT OR REPLACE INTO SpendSplits VALUES(?,?,?,?,?,?,?,?,?,?,?,?);

getSplitForSpend:
SELECT * FROM SpendSplits WHERE spendId = ? AND deletedBy ISNULL;

deleteSpendSplit:
UPDATE SpendSplits SET deletedBy = ?, deletedAt = ?, status = ? WHERE spendId = ?;

getSpendSplitsToSync:
SELECT * FROM SpendSplits WHERE status = ?;

clearSplitData:
DELETE FROM SpendSplits;
