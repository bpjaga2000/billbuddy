selectAll:
SELECT * FROM Users;

selectCurrentUser:
SELECT * FROM Users WHERE id = :id;

insertUsers:
INSERT OR REPLACE INTO Users VALUES (?,?,?,?,?,?,?,?,?,?,?);

getUserFromId:
SELECT * FROM Users WHERE id = ?;

getMemberDetailsOfGroup:
SELECT GroupMembers.id AS groupMemberId, Users.id, Users.name FROM Users JOIN GroupMembers ON Users.id = GroupMembers.userId WHERE groupId = ? AND deletedBy ISNULL;

searchUsers:
SELECT * FROM Users WHERE name LIKE :searchTag OR email LIKE :searchTag;