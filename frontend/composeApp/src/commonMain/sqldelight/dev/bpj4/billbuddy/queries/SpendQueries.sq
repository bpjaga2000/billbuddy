insertSpends:
INSERT OR REPLACE INTO Spends VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?);

getSpendsForGroup:
SELECT * FROM Spends WHERE groupId = ? AND deletedBy ISNULL ORDER BY spentAt DESC ;

getSpendWithId:
SELECT * FROM Spends WHERE id = ?;

removeSpend:
DELETE FROM Spends WHERE id = ?;

deleteSpend:
UPDATE Spends SET deletedBy = ?, deletedAt = ?, status = ? WHERE id = ?;